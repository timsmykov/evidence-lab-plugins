{
  "schema_version": 1,
  "packs": [
    {
      "id": "evidence-lab-core",
      "version": "0.5.0",
      "layer": "core",
      "display_name": "Evidence Lab Core",
      "description": "Agent-first research foundations, fast researcher onboarding, reproducible pack selection, source verification, citation handling, and scientific critical thinking.",
      "capabilities": [
        "onboarding",
        "pack-selection",
        "installation-lifecycle",
        "paper-lookup",
        "citation-management",
        "critical-thinking"
      ],
      "selection": {
        "always": true,
        "rules": []
      },
      "dependencies": [],
      "conflicts": [],
      "runtimes": [
        "claude-code",
        "codex"
      ]
    },
    {
      "id": "quantitative-sciences",
      "version": "0.2.0",
      "layer": "domain",
      "display_name": "Quantitative Sciences",
      "description": "Statistical analysis, power and sample-size planning, uncertainty and units, and publication-grade scientific visualization for quantitative research.",
      "capabilities": [
        "statistical-analysis",
        "statistical-power",
        "uncertainty-and-units",
        "scientific-visualization"
      ],
      "selection": {
        "always": false,
        "rules": [
          {
            "id": "quantitative-domain",
            "priority": 300,
            "when": {
              "any": {
                "domains": [
                  "mathematics",
                  "statistics",
                  "physics",
                  "engineering"
                ]
              }
            },
            "reason": "The research domain commonly requires quantitative scientific methods."
          },
          {
            "id": "quantitative-method",
            "priority": 250,
            "when": {
              "any": {
                "methods": [
                  "statistics",
                  "code",
                  "formulas",
                  "mathematical-models"
                ]
              }
            },
            "reason": "The stated methods require quantitative analysis or mathematical checks."
          }
        ]
      },
      "dependencies": [
        "evidence-lab-core"
      ],
      "conflicts": [],
      "runtimes": [
        "claude-code",
        "codex"
      ]
    },
    {
      "id": "data-and-pdf",
      "version": "0.2.0",
      "layer": "workflow",
      "display_name": "Data and PDF",
      "description": "Document conversion, reproducible public-database retrieval, and exploratory analysis for papers, PDFs, tables, and structured research datasets.",
      "capabilities": [
        "document-conversion",
        "database-lookup",
        "exploratory-data-analysis"
      ],
      "selection": {
        "always": false,
        "rules": [
          {
            "id": "data-materials",
            "priority": 300,
            "when": {
              "any": {
                "materials": [
                  "pdf",
                  "tables",
                  "datasets"
                ]
              }
            },
            "reason": "The frequent materials need document conversion or structured-data inspection."
          },
          {
            "id": "data-collection-with-sources",
            "priority": 200,
            "when": {
              "all": {
                "workflows": [
                  "collect-and-compare-data",
                  "analyze-data"
                ],
                "materials": [
                  "papers",
                  "pdf",
                  "tables",
                  "datasets"
                ]
              }
            },
            "reason": "The requested data workflow has a supported source or data material."
          }
        ]
      },
      "dependencies": [
        "evidence-lab-core"
      ],
      "conflicts": [],
      "runtimes": [
        "claude-code",
        "codex"
      ]
    },
    {
      "id": "full-research-cycle",
      "version": "0.2.0",
      "layer": "workflow",
      "display_name": "Full Research Cycle",
      "description": "A complete research workflow from testable hypotheses and study design through literature synthesis, manuscript writing, diagrams, and evidence-bounded peer review.",
      "capabilities": [
        "hypothesis-generation",
        "study-design",
        "literature-review",
        "academic-writing",
        "peer-review",
        "research-diagrams"
      ],
      "selection": {
        "always": false,
        "rules": [
          {
            "id": "full-cycle-workflow",
            "priority": 300,
            "when": {
              "any": {
                "workflows": [
                  "full-research-cycle",
                  "literature-review",
                  "prepare-publication",
                  "quality-review"
                ]
              }
            },
            "reason": "The requested workflow uses the end-to-end research procedures."
          },
          {
            "id": "full-cycle-writing-stage",
            "priority": 200,
            "when": {
              "any": {
                "stages": [
                  "writing",
                  "systematic-review"
                ]
              }
            },
            "reason": "The current stage requires literature, writing, or review procedures."
          }
        ]
      },
      "dependencies": [
        "evidence-lab-core"
      ],
      "conflicts": [],
      "runtimes": [
        "claude-code",
        "codex"
      ]
    }
  ]
}
