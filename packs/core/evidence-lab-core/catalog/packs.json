            "id": "publication-monitoring-workflow",
            "priority": 300,
            "when": {
              "any": {
                "workflows": [
                  "monitor-publications"
                ]
              }
            },
            "reason": "The researcher wants a repeatable update and deduplication workflow for new publications."
          }
        ]
      },
      "dependencies": [
        "evidence-lab-core"
      ],
      "conflicts": [],
      "runtimes": [
        "claude-code",
        "codex"
      ]
    },
    {
      "id": "qualitative-research",
      "version": "0.1.1",
      "layer": "workflow",
      "display_name": "Qualitative Research",
