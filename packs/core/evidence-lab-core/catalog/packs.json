      },
      "dependencies": [
        "evidence-lab-core"
      ],
      "conflicts": [],
      "runtimes": [
        "claude-code",
        "codex"
      ]
    },
    {
      "id": "structured-data-analysis",
      "version": "0.1.1",
      "layer": "workflow",
      "display_name": "Structured Data Analysis",
      "description": "Reproducible public-database retrieval and exploratory analysis for tables and datasets without unrelated document-conversion tooling.",
      "capabilities": [
        "database-lookup",
        "exploratory-data-analysis"
      ],
      "selection": {
        "always": false,
        "rules": [
          {
            "id": "structured-data-material",
            "priority": 300,
            "when": {
              "any": {
                "materials": [
