{
  "schema_version": 1,
  "packs": [
    {
      "id": "evidence-lab-core",
      "version": "0.10.0",
      "layer": "core",
      "display_name": "Evidence Lab Core",
      "description": "Agent-first research foundations, fast researcher onboarding, reproducible pack selection, source verification, citation handling, and scientific critical thinking.",
      "capabilities": [
        "onboarding",
        "pack-selection",
        "companion-plugin-planning",
        "installation-lifecycle",
        "paper-lookup",
        "citation-management",
        "critical-thinking"
      ],
      "selection": {
        "always": true,
        "rules": []
      },
      "dependencies": [],
      "conflicts": [],
      "runtimes": [
        "claude-code",
        "codex"
      ]
    },
    {
      "id": "life-sciences",
      "version": "0.1.1",
      "layer": "domain",
      "display_name": "Life Sciences",
      "description": "Domain checks for life-science protocols, biological controls, bias, biosafety boundaries, reporting context, and image acquisition metadata.",
      "capabilities": [
        "life-science-protocols"
      ],
      "selection": {
        "always": false,
        "rules": [
          {
            "id": "life-science-planning",
            "priority": 300,
            "when": {
              "all": {
                "domains": [
                  "life-sciences"
                ],
                "stages": [
                  "planning"
                ]
              }
            },
            "reason": "Life-science study planning needs domain-specific protocol and bias checks."
          },
          {
            "id": "life-science-images",
            "priority": 250,
            "when": {
              "all": {
                "domains": [
                  "life-sciences"
                ],
                "materials": [
                  "images"
                ]
              }
            },
            "reason": "Life-science images need acquisition and biological-context metadata."
          }
        ]
      },
      "dependencies": [
        "evidence-lab-core"
      ],
      "conflicts": [],
      "runtimes": [
        "claude-code",
        "codex"
      ]
    },
    {
      "id": "quantitative-sciences",
      "version": "0.3.1",
      "layer": "domain",
      "display_name": "Quantitative Sciences",
      "description": "Statistical analysis, power and sample-size planning, uncertainty and units, and publication-grade scientific visualization for quantitative research.",
      "capabilities": [
        "statistical-analysis",
        "statistical-power",
        "uncertainty-and-units",
        "scientific-visualization"
      ],
      "selection": {
        "always": false,
        "rules": [
          {
            "id": "quantitative-method",
            "priority": 300,
            "when": {
              "any": {
                "methods": [
                  "statistics",
                  "code",
                  "formulas",
                  "mathematical-models"
                ]
              }
            },
            "reason": "The stated methods require quantitative analysis or mathematical checks."
          }
        ]
      },
      "dependencies": [
        "evidence-lab-core"
      ],
      "conflicts": [],
      "runtimes": [
        "claude-code",
        "codex"
      ]
    },
    {
      "id": "data-and-pdf",
      "version": "1.0.1",
      "layer": "workflow",
      "display_name": "Data and PDF",
      "description": "Compatibility entry point for mixed document-and-data projects; installs focused document-evidence and structured-data-analysis packs as dependencies.",
      "capabilities": [
        "data-and-pdf-compatibility"
      ],
      "selection": {
        "always": false,
        "rules": [
          {
            "id": "data-and-pdf-full-cycle-datasets",
            "priority": 300,
            "when": {
              "all": {
                "workflows": [
                  "full-research-cycle"
                ]
              },
              "contains_all": {
                "materials": [
                  "pdf",
                  "datasets"
                ]
              }
            },
            "reason": "The complete research route uses both document and structured-data procedures."
          },
          {
            "id": "data-and-pdf-full-cycle-tables",
            "priority": 300,
            "when": {
              "all": {
                "workflows": [
                  "full-research-cycle"
                ]
              },
              "contains_all": {
                "materials": [
                  "pdf",
                  "tables"
                ]
              }
            },
            "reason": "The complete research route uses both document and structured-data procedures."
          }
        ]
      },
      "dependencies": [
        "document-evidence",
        "structured-data-analysis"
      ],
      "conflicts": [],
      "runtimes": [
        "claude-code",
        "codex"
      ]
    },
    {
      "id": "document-evidence",
      "version": "0.1.1",
      "layer": "workflow",
      "display_name": "Document Evidence",
      "description": "Reproducible conversion of supported research documents into inspectable Markdown without installing database retrieval or dataset analysis tools.",
      "capabilities": [
        "document-conversion"
      ],
      "selection": {
        "always": false,
        "rules": [
          {
            "id": "document-evidence-material",
            "priority": 300,
            "when": {
              "any": {
                "materials": [
                  "pdf"
                ]
              }
            },
            "reason": "PDF evidence needs deterministic document conversion and extraction."
          }
        ]
      },
      "dependencies": [
        "evidence-lab-core"
      ],
      "conflicts": [],
      "runtimes": [
        "claude-code",
        "codex"
      ]
    },
    {
      "id": "full-research-cycle",
      "version": "1.0.1",
      "layer": "workflow",
      "display_name": "Full Research Cycle",
      "description": "Compatibility entry point for the complete research cycle; installs the focused research-design and literature-publication packs as declared dependencies.",
      "capabilities": [
        "full-research-cycle-compatibility"
      ],
      "selection": {
        "always": false,
        "rules": [
          {
            "id": "full-cycle-workflow",
            "priority": 300,
            "when": {
              "any": {
                "workflows": [
                  "full-research-cycle"
                ]
              }
            },
            "reason": "The explicit full-cycle route installs both focused workflow packs."
          }
        ]
      },
      "dependencies": [
        "research-design",
        "literature-publication"
      ],
      "conflicts": [],
      "runtimes": [
        "claude-code",
        "codex"
      ]
    },
    {
      "id": "literature-publication",
      "version": "0.1.1",
      "layer": "workflow",
      "display_name": "Literature and Publication",
      "description": "Literature synthesis, evidence-bounded academic writing, editable research diagrams, and manuscript review without installing study-design procedures.",
      "capabilities": [
        "literature-review",
        "academic-writing",
        "peer-review",
        "research-diagrams"
      ],
      "selection": {
        "always": false,
        "rules": [
          {
            "id": "literature-publication-workflow",
            "priority": 300,
            "when": {
              "any": {
                "workflows": [
                  "literature-review",
                  "prepare-publication",
                  "quality-review"
                ]
              }
            },
            "reason": "The requested workflow needs literature synthesis, publication writing, or manuscript review."
          },
          {
            "id": "literature-publication-writing",
            "priority": 200,
            "when": {
              "any": {
                "stages": [
                  "writing"
                ]
              }
            },
            "reason": "The researcher is actively preparing scholarly text for publication."
          }
        ]
      },
      "dependencies": [
        "evidence-lab-core"
      ],
      "conflicts": [],
      "runtimes": [
        "claude-code",
        "codex"
      ]
    },
    {
      "id": "publication-monitoring",
      "version": "0.1.1",
      "layer": "workflow",
      "display_name": "Publication Monitoring",
      "description": "Repeatable monitoring of new scholarly publications with explicit queries, stable deduplication, checkpoints, and source-linked update digests.",
      "capabilities": [
        "publication-monitoring"
      ],
      "selection": {
        "always": false,
        "rules": [
