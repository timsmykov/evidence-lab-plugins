        {"id": "life-sciences", "label": "Медицина и науки о жизни"},
        {"id": "physics", "label": "Физика"},
        {"id": "engineering", "label": "Инженерные науки"},
        {"id": "mathematics", "label": "Математика"},
        {"id": "statistics", "label": "Статистика и анализ данных"},
        {"id": "social-sciences", "label": "Экономика и общественные науки"},
        {"id": "humanities", "label": "Гуманитарные науки"},
        {"id": "interdisciplinary", "label": "Междисциплинарные исследования"}
      ],
      "allow_free_text": true
    },
    {
      "id": "workflows",
      "prompt": "Что вы хотите сделать в первую очередь?",
