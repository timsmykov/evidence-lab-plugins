      "allow_free_text": true
    },
    {
      "id": "stages",
      "prompt": "На каком этапе находится ваша работа?",
      "multiple": true,
      "options": [
        {"id": "planning", "label": "Выбираю или планирую тему"},
        {"id": "active-research", "label": "Активно веду исследование"},
        {"id": "writing", "label": "Готовлю статью, отчёт или заявку"},
        {"id": "systematic-review", "label": "Провожу систематический обзор или мета-анализ"},
        {"id": "supervision", "label": "Преподаю или сопровождаю исследования"},
        {"id": "unknown", "label": "Пока не уверен"}
