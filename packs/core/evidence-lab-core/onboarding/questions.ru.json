        {"id": "design-study", "label": "Спроектировать исследование или эксперимент"},
        {"id": "monitor-publications", "label": "Следить за новыми публикациями"},
        {"id": "literature-review", "label": "Провести обзор литературы"},
        {"id": "collect-and-compare-data", "label": "Собрать и сравнить данные"},
        {"id": "analyze-data", "label": "Проанализировать данные или код"},
        {"id": "prepare-publication", "label": "Подготовить статью или отчёт"},
        {"id": "quality-review", "label": "Проверить качество исследования"}
      ],
      "allow_free_text": true
    },
    {
      "id": "materials",
      "prompt": "С какими материалами и методами вы работаете чаще всего?",
      "multiple": true,
      "options": [
        {"id": "papers", "label": "Научные статьи"},
        {"id": "pdf", "label": "PDF"},
        {"id": "tables", "label": "Таблицы"},
        {"id": "datasets", "label": "Наборы данных"},
        {"id": "code", "label": "Код и вычисления", "profile_field": "methods"},
        {"id": "formulas", "label": "Формулы", "profile_field": "methods"},
        {"id": "mathematical-models", "label": "Математические модели", "profile_field": "methods"},
        {"id": "qualitative-text", "label": "Интервью, опросы или тексты"},
        {"id": "images", "label": "Исследовательские изображения"}
