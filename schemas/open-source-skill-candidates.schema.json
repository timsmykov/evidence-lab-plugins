{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lab.dev/schemas/open-source-skill-candidates.schema.json",
  "title": "Audited open-source Agent Skill candidates",
  "type": "object",
  "required": ["schema_version", "audited_at", "policy", "candidates"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "audited_at": {"type": "string", "format": "date"},
    "policy": {"type": "string", "minLength": 80},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "repository", "repository_url", "commit", "skill_path",
          "skill_url", "license", "license_url", "capabilities",
          "disposition", "bundled", "rationale", "required_before_import"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"},
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "repository_url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
          "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "skill_path": {"type": "string", "minLength": 3},
          "skill_url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
          "license": {"const": "MIT"},
          "license_url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"}
          },
          "disposition": {
            "enum": ["take-candidate", "adapt-candidate", "domain-extension", "reference-only"]
          },
          "bundled": {"const": false},
          "rationale": {"type": "string", "minLength": 50},
          "risks": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 15}
          },
          "required_before_import": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 15}
          }
        }
      }
    }
  }
}
