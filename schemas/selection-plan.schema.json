{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-lab-plugins/schemas/selection-plan.schema.json",
  "title": "Evidence Lab pack selection plan",
  "type": "object",
  "required": ["schema_version", "policy_version", "profile", "packs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 2},
    "policy_version": {"const": 1},
    "profile": {"type": "object"},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "layer", "reason", "rule_ids", "matched_rules"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "version": {"type": "string"},
          "layer": {"type": "string"},
          "reason": {"type": "string", "minLength": 3},
          "rule_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
          },
          "matched_rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "reason", "evidence"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
                "reason": {"type": "string", "minLength": 3},
                "evidence": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
