{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-lab-plugins/schemas/selection-plan.schema.json",
  "title": "Evidence Lab pack selection plan",
  "type": "object",
  "required": ["schema_version", "profile", "packs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"type": "object"},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "layer", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "version": {"type": "string"},
          "layer": {"type": "string"},
          "reason": {"type": "string", "minLength": 3}
        }
      }
    }
  }
}
