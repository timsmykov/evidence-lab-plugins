{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lab.dev/schemas/post-install-probes.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timeout_seconds", "packs"],
  "properties": {
    "schema_version": {"const": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
    "packs": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["pack_id", "pack_path", "probes"],
      "properties": {
        "pack_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "pack_path": {"type": "string", "pattern": "^packs/(core|workflows|domains)/[a-z0-9-]+$"},
        "probes": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "skill_id", "capability", "required_paths"],
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
            "skill_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
            "capability": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
            "required_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^skills/[a-z0-9-]+/.+$"}},
            "command": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}
          }
        }}
      }
    }}
  }
}
