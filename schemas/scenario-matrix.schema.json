{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lab.dev/schemas/scenario-matrix.schema.json",
  "title": "Evidence Lab pack-boundary scenario matrix",
  "type": "object",
  "required": ["schema_version", "baseline_pack", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "baseline_pack": {"type": "string"},
    "scenarios": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "segment", "research_goal", "profile", "required_capabilities", "optional_capabilities", "expected_selected_packs", "expected_missing_capabilities"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "segment": {"type": "string", "minLength": 10},
          "research_goal": {"type": "string", "minLength": 20},
          "profile": {"type": "object"},
          "required_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "optional_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "expected_selected_packs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "expected_missing_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  }
}
