{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lab.dev/schemas/external-plugin-plan.schema.json",
  "title": "Evidence Lab Codex companion-plugin plan",
  "type": "object",
  "required": ["schema_version", "host", "actions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "host": {"enum": ["codex", "claude-code"]},
    "reason": {"type": "string", "minLength": 10},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plugin_id", "display_name", "action", "install_mode", "credential_mode", "reason"],
        "additionalProperties": false,
        "properties": {
          "plugin_id": {"type": "string", "minLength": 8},
          "display_name": {"type": "string", "minLength": 2},
          "action": {"enum": ["install-after-confirmation", "recommend-after-validation", "offer-opt-in", "offer-connection", "withhold-pending-benchmark"]},
          "install_mode": {"enum": ["already-present", "marketplace", "plugins-ui"]},
          "credential_mode": {"enum": ["none", "local-app", "account-connection", "mixed", "unknown"]},
          "reason": {"type": "string", "minLength": 40}
        }
      }
    }
  }
}
