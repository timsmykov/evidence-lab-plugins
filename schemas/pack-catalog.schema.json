{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lab.dev/schemas/pack-catalog.schema.json",
  "title": "Evidence Lab bootstrap pack catalog",
  "type": "object",
  "required": ["schema_version", "packs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 2},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "version", "layer", "display_name", "description",
          "capabilities", "selection", "dependencies", "conflicts",
          "runtimes", "foundation", "skills"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"},
          "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
          "layer": {"enum": ["core", "workflow", "domain", "local"]},
          "display_name": {"type": "string", "minLength": 3},
          "description": {"type": "string", "minLength": 60},
          "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "selection": {"type": "object"},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "conflicts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "runtimes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["claude-code", "codex"]}},
          "foundation": {"type": "boolean"},
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "quality_status"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"},
                "quality_status": {
                  "enum": ["needs-substantive-work", "needs-representative-testing", "review-ready", "production", "support-only", "reference-only"]
                }
              }
            }
          }
        }
      }
    }
  }
}
