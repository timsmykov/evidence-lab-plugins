{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lab.dev/schemas/pack-boundary-decisions.schema.json",
  "title": "Evidence Lab pack-boundary decisions",
  "type": "object",
  "required": ["schema_version", "status", "current_pack_decisions", "prioritized_additions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["proposed", "approved", "implemented"]},
    "current_pack_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pack_id", "decision", "scenario_evidence", "rationale", "target_boundary"],
        "additionalProperties": false,
        "properties": {
          "pack_id": {"type": "string"},
          "decision": {"enum": ["keep", "split", "deprecate"]},
          "scenario_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "rationale": {"type": "string", "minLength": 40},
          "target_boundary": {"type": "string", "minLength": 30}
        }
      }
    },
    "prioritized_additions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pack_id", "priority", "capabilities", "trigger_scenarios", "cross_taxonomy_reason", "lifecycle_status"],
        "additionalProperties": false,
        "properties": {
          "pack_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "priority": {"enum": ["P1", "P2", "P3"]},
          "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "trigger_scenarios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "cross_taxonomy_reason": {"type": "string", "minLength": 40},
          "lifecycle_status": {"enum": ["planned", "draft", "review", "production"]}
        }
      }
    }
  }
}
