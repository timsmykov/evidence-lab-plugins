{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lab.local/schemas/release-lock.schema.json",
  "title": "Evidence Lab immutable release lock",
  "type": "object",
  "required": ["schema_version", "release_tag", "channel", "source", "catalog_sha256", "packs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "release_tag": {"type": "string", "pattern": "^release-[0-9]{4}[.](0[1-9]|1[0-2])[.][1-9][0-9]*$"},
    "channel": {"const": "stable"},
    "source": {
      "type": "object",
      "required": ["repository", "commit"],
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "catalog_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "layer", "status", "path", "content_sha256", "hosts", "license"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "version": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"},
          "layer": {"enum": ["core", "workflow", "domain", "local"]},
          "status": {"enum": ["draft", "review", "production", "deprecated"]},
          "path": {"type": "string", "pattern": "^packs/(core|workflows|domains|local)/[a-z0-9][a-z0-9-]*$"},
          "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["claude-code", "codex"]}},
          "license": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
