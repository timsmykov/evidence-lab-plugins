{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-lab-plugins/schemas/onboarding-plan-copy.schema.json",
  "title": "Localized Evidence Lab installation-plan copy",
  "type": "object",
  "required": ["schema_version", "locale", "heading", "intro", "why_label", "details", "pending", "confirmation", "hosts", "packs", "rules"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "locale": {"enum": ["en", "ru"]},
    "heading": {"type": "string", "minLength": 3},
    "intro": {"type": "string", "minLength": 3},
    "why_label": {"type": "string", "minLength": 2},
    "details": {"type": "string", "minLength": 3},
    "pending": {"type": "string", "minLength": 3},
    "confirmation": {"type": "string", "minLength": 3},
    "hosts": {
      "type": "object",
      "required": ["codex", "claude-code"],
      "additionalProperties": false,
      "properties": {
        "codex": {"type": "string", "minLength": 2},
        "claude-code": {"type": "string", "minLength": 2}
      }
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "purpose"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 3},
          "purpose": {"type": "string", "minLength": 3}
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "reason": {"type": "string", "minLength": 3}
        }
      }
    }
  }
}
