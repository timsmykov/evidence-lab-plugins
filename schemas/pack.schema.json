{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lab.dev/schemas/pack.schema.json",
  "title": "Evidence Lab host-neutral pack",
  "type": "object",
  "required": ["id", "version", "layer", "display_name", "description", "category", "author", "license", "capabilities", "selection", "dependencies", "conflicts", "runtimes", "interface"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "layer": {"enum": ["core", "workflow", "domain", "local"]},
    "display_name": {"type": "string", "minLength": 3},
    "description": {"type": "string", "minLength": 60, "maxLength": 1024},
    "category": {"type": "string", "minLength": 2},
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "license": {"type": "string", "minLength": 3},
    "foundation": {
      "type": "boolean",
      "description": "True only when every bootstrap installation must include this pack as part of the frozen researcher foundation."
    },
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "selection": {"$ref": "#/$defs/selection"},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "conflicts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "runtimes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["claude-code", "codex"]}},
    "interface": {
      "type": "object",
      "required": ["short_description", "long_description", "capabilities", "default_prompt"],
      "additionalProperties": false,
      "properties": {
        "short_description": {"type": "string", "minLength": 10},
        "long_description": {"type": "string", "minLength": 30},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "default_prompt": {"type": "string", "minLength": 10}
      }
    }
  },
  "$defs": {
    "profile_conditions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "workflows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "materials": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "selection_rule": {
      "type": "object",
      "required": ["id", "priority", "when", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
        "reason": {"type": "string", "minLength": 10},
        "when": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "any": {"$ref": "#/$defs/profile_conditions"},
            "all": {"$ref": "#/$defs/profile_conditions"},
            "contains_all": {"$ref": "#/$defs/profile_conditions"},
            "none": {"$ref": "#/$defs/profile_conditions"}
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "required": ["always", "rules"],
      "additionalProperties": false,
      "properties": {
        "always": {"type": "boolean"},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/selection_rule"}}
      }
    }
  }
}
