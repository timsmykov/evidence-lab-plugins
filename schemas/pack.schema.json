{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-lab-plugins/schemas/pack.schema.json",
  "title": "Evidence Lab host-neutral pack",
  "type": "object",
  "required": ["id", "version", "layer", "display_name", "description", "category", "author", "capabilities", "selection", "dependencies", "conflicts", "runtimes", "interface"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "layer": {"enum": ["core", "workflow", "domain", "local"]},
    "display_name": {"type": "string", "minLength": 3},
    "description": {"type": "string", "minLength": 60, "maxLength": 1024},
    "category": {"type": "string", "minLength": 2},
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "selection": {
      "type": "object",
      "required": ["always", "domains", "workflows", "materials", "stages", "methods"],
      "additionalProperties": false,
      "properties": {
        "always": {"type": "boolean"},
        "domains": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "workflows": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "materials": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "stages": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "methods": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "conflicts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "runtimes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["claude-code", "codex"]}},
    "interface": {
      "type": "object",
      "required": ["short_description", "long_description", "capabilities", "default_prompt"],
      "additionalProperties": false,
      "properties": {
        "short_description": {"type": "string", "minLength": 10},
        "long_description": {"type": "string", "minLength": 30},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "default_prompt": {"type": "string", "minLength": 10}
      }
    }
  }
}
