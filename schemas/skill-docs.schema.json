{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Lab user-facing skill catalogue copy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "groups", "skills"],
  "properties": {
    "schema_version": {"const": 1},
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 2, "maxLength": 80},
          "description": {"type": "string", "minLength": 10, "maxLength": 240}
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "group", "use_when", "produces"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "group": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "use_when": {"type": "string", "minLength": 10, "maxLength": 220},
          "produces": {"type": "string", "minLength": 5, "maxLength": 180}
        }
      }
    }
  }
}
