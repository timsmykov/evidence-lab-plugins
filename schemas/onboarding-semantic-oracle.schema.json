{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lab.local/schemas/onboarding-semantic-oracle.schema.json",
  "title": "Evidence Lab onboarding semantic oracle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_bundle", "scenarios"],
  "properties": {
    "schema_version": {"const": 1},
    "scenario_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "tests/acceptance/onboarding-terra-10.scenarios.ru.json"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rationale", "packs", "capabilities"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "rationale": {"type": "string", "minLength": 20},
          "packs": {"$ref": "#/$defs/classification"},
          "capabilities": {"$ref": "#/$defs/classification"}
        }
      }
    }
  },
  "$defs": {
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "allowed", "forbidden"],
      "properties": {
        "required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "allowed": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
