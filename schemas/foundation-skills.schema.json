{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-lab-plugins/schemas/foundation-skills.schema.json",
  "type": "object",
  "required": ["schema_version", "target_size", "definition", "skills", "outside_foundation"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "target_size": {"type": "integer", "minimum": 20, "maximum": 30},
    "definition": {"type": "string", "minLength": 80},
    "skills": {
      "type": "array",
      "minItems": 20,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["id", "group", "state", "priority", "rationale"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"},
          "group": {"enum": ["workspace", "sources", "reasoning", "documents", "synthesis", "design", "data", "analysis", "communication", "publication", "reproducibility"]},
          "state": {"enum": ["planned", "implemented-needs-substantive-work", "implemented-needs-representative-testing", "implemented-review-ready", "implemented-production"]},
          "current_skill": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"},
          "priority": {"enum": ["P0", "P1", "P2"]},
          "rationale": {"type": "string", "minLength": 30},
          "upstream_candidate_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"}
          }
        },
        "allOf": [
          {"if": {"properties": {"state": {"const": "planned"}}}, "then": {"not": {"required": ["current_skill"]}}, "else": {"required": ["current_skill"]}}
        ]
      }
    },
    "outside_foundation": {
      "type": "object",
      "required": ["workflow_add_ons", "domain_add_ons", "support_components"],
      "additionalProperties": false,
      "properties": {
        "workflow_add_ons": {"type": "array", "items": {"type": "string"}},
        "domain_add_ons": {"type": "array", "items": {"type": "string"}},
        "support_components": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
