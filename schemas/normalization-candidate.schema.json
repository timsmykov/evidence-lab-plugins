{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lab.dev/schemas/normalization-candidate.schema.json",
  "title": "Untrusted LLM normalization candidate",
  "type": "object",
  "required": ["schema_version", "mappings", "unresolved_question_ids", "follow_up_question"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_question_id", "field", "value", "confidence", "rationale"],
        "additionalProperties": false,
        "properties": {
          "source_question_id": {"type": "string"},
          "field": {"enum": ["domains", "workflows", "materials", "stages", "methods"]},
          "value": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "rationale": {"type": "string", "minLength": 3, "maxLength": 500}
        }
      }
    },
    "unresolved_question_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "follow_up_question": {"type": ["string", "null"], "minLength": 3, "maxLength": 500}
  }
}
