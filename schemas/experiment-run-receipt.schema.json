{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lab.local/schemas/experiment-run-receipt.schema.json",
  "title": "Evidence Lab onboarding experiment run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cohort_id",
    "candidate_id",
    "scenario_id",
    "attempt",
    "run_id",
    "validity",
    "product_outcome",
    "harness_outcome",
    "terminal_state",
    "failure_class",
    "checks",
    "hashes",
    "selected_packs",
    "durations_seconds",
    "warnings",
    "adjudication_status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "cohort_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scenario_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "attempt": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "minLength": 1},
    "supersedes_run_id": {"type": ["string", "null"]},
    "validity": {"enum": ["VALID", "INVALID"]},
    "product_outcome": {"enum": ["PASS", "FAIL", "NOT_ASSESSED"]},
    "harness_outcome": {"enum": ["PASS", "FAIL"]},
    "terminal_state": {
      "enum": ["COMPLETED", "PRODUCT_FAIL", "SAFETY_FAIL", "HARNESS_FAIL", "INFRA_INVALID", "ARTIFACT_REJECTED", "OPERATOR_ABORTED"]
    },
    "failure_class": {"type": ["string", "null"]},
    "checks": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "selected_packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "version": {"type": "string", "minLength": 1}
        }
      }
    },
    "durations_seconds": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "adjudication_status": {"enum": ["NOT_REQUIRED", "PENDING", "RESOLVED"]}
  }
}
