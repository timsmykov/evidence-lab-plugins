{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lab.local/schemas/experiment-adjudication.schema.json",
  "title": "Evidence Lab onboarding experiment adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "candidate_id", "automated_classification", "reviewer_classification", "rationale", "artifact_hashes", "resolved_at"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "automated_classification": {"type": "string", "minLength": 1},
    "reviewer_classification": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "artifact_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "minItems": 1},
    "matcher_error": {"enum": ["NONE", "FALSE_POSITIVE", "FALSE_NEGATIVE"]},
    "resolved_at": {"type": "string", "format": "date-time"}
  }
}
